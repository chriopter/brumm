#!/usr/bin/env bash
# Run a development build: `dev/run` starts the daemon in the foreground with
# its logs; `dev/run ui` opens the TUI against it, `dev/run gui` the window.
set -euo pipefail
cd "$(dirname "$0")/.."

mkdir -p tmp
cargo build --release --locked -p brumm
cp "${CARGO_TARGET_DIR:-target}/release/brumm" tmp/brumm
if [[ ${1:-} == ui ]]; then
  exec tmp/brumm --tui
fi
if [[ ${1:-} == gui ]]; then
  dev/build-gui tmp
  exec tmp/brumm-gui
fi
# The installed daemon would hold the socket and the MPRIS name.
systemctl --user stop brumm.service 2>/dev/null || true
exec tmp/brumm daemon
