#!/usr/bin/env bash
# Fake service setup and switching, isolated from the real player.
set -euo pipefail
cd "$(dirname "$0")/.."
unset BRUMM_FIXTURE_FIRST_RUN BRUMM_FIXTURE_ALL_SERVICES BRUMM_FIXTURE_PROVIDER BRUMM_PREVIEW
case "${1:-first-run}" in
  first-run) export BRUMM_FIXTURE_FIRST_RUN=1 ;;
  connected) export BRUMM_FIXTURE_ALL_SERVICES=1 ;;
  apple|tidal|spotify) export BRUMM_FIXTURE_PROVIDER="$1" BRUMM_FIXTURE_ALL_SERVICES=1 ;;
  *) echo 'Usage: tools/demo-services [first-run|connected|apple|tidal|spotify]' >&2; exit 2 ;;
esac
export BRUMM_PROTOTYPE_BUILD=${BRUMM_PROTOTYPE_BUILD:-tmp/services-demo}
exec bin/prototype
