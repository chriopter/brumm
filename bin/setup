#!/usr/bin/env bash
# Build brumm from this checkout and install it, like a release would be:
# the program, the systemd unit, the launcher entry and the bar widget.
# Safe to re-run. Development builds never update themselves from GitHub.
#
# To embed a fresh Apple Music developer token, pass the MusicKit key, e.g.
# from 1Password:
#   APPLE_KEY_ID=… APPLE_TEAM_ID=… APPLE_PRIVATE_KEY="$(op read op://…)" bin/setup
# Without it, brumm uses developer_token from ~/.config/brumm/config.json.
set -euo pipefail
cd "$(dirname "$0")/.."

command -v go >/dev/null || { echo "brumm needs Go: omarchy pkg add go" >&2; exit 1; }

ldflags="-s -w -X main.version=dev-$(git describe --tags --always --dirty 2>/dev/null || echo local)"
if [[ -n ${APPLE_PRIVATE_KEY:-} ]]; then
  token=$(go run ./tools/devtoken)
  ldflags+=" -X github.com/chriopter/brumm/internal/config.DevToken=$token"
  echo "embedded a new developer token (valid six months)"
fi

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
echo "building brumm"
go build -trimpath -ldflags "$ldflags" -o "$stage/brumm" .
cp -r omarchy "$stage/"
"$stage/brumm" setup "$stage"

# Pick up the new build now rather than at the next pause.
if systemctl --user is-active --quiet brumm.service; then
  systemctl --user restart brumm.service
fi

if ! grep -q '"user_token"' "${XDG_CONFIG_HOME:-$HOME/.config}/brumm/config.json" 2>/dev/null; then
  echo "next: sign in with 'brumm login'"
fi
