#!/usr/bin/env bash
# Screenshot the window against a stand-in daemon (tools/fakedaemon), off
# screen and apart from the real brumm:
#   bin/gui-shot out.png ["KEYS"] [WxH]
# KEYS are pressed first, named as the players name them ("o", "3 enter");
# GUI_SHOT_MS is how long after the start the picture is taken (1500),
# GUI_BUILD the build directory (tmp/gui-build), so builds can run side by
# side.
set -euo pipefail
cd "$(dirname "$0")/.."

out=$(realpath -m "$1")
build=${GUI_BUILD:-tmp/gui-build}
bin/build-gui "$build"
go build -o "$build/fakedaemon" ./tools/fakedaemon
run=$(mktemp -d)
trap 'kill $fake 2>/dev/null; rm -rf "$run"' EXIT
XDG_RUNTIME_DIR=$run "$build/fakedaemon" 2>/dev/null &
fake=$!
while [[ ! -S $run/brumm.sock ]]; do sleep 0.1; done
# PATH is emptied so a missing daemon can never start the real one.
env -u QT_QPA_PLATFORMTHEME PATH=/nonexistent QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 QT_QUICK_BACKEND=rhi QSG_RHI_BACKEND=opengl \
  XDG_RUNTIME_DIR="$run" XDG_CACHE_HOME="$run/cache" XDG_CONFIG_HOME="$run/config" \
  BRUMM_GUI_SHOT="$out" BRUMM_GUI_KEYS="${2:-}" BRUMM_GUI_SIZE="${3:-}" BRUMM_GUI_SHOT_MS="${GUI_SHOT_MS:-1500}" BRUMM_GUI_CLICKS="${GUI_CLICKS:-}" "$build/brumm-gui"
