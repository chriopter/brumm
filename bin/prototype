#!/usr/bin/env bash
# Isolated API navigation prototype. Never touches the real player/account.
set -euo pipefail
cd "$(dirname "$0")/.."
if ! go version >/dev/null 2>&1 && command -v mise >/dev/null; then
  export PATH="$(mise where go)/bin:$PATH"
fi
export GOCACHE=${GOCACHE:-/tmp/brumm-go-cache}
build=tmp/prototype-build
GUI_BUILD="$build" bin/build-gui "$build"
go build -o "$build/fakedaemon" ./tools/fakedaemon
go build -o "$build/brumm" .
run=$(mktemp -d /tmp/brumm-prototype.XXXXXX)
desktop_runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export BRUMM_DESKTOP_RUNTIME="$desktop_runtime"
if [[ -n ${WAYLAND_DISPLAY:-} && $WAYLAND_DISPLAY != /* ]]; then
  export WAYLAND_DISPLAY="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$WAYLAND_DISPLAY"
fi
export XDG_RUNTIME_DIR="$run" XDG_CONFIG_HOME="$run/config" XDG_CACHE_HOME="$run/cache" BRUMM_PROTOTYPE=1
"$build/fakedaemon" >"$run/daemon.log" 2>&1 &
fake=$!
trap 'kill "$fake" 2>/dev/null || true; rm -rf "$run"' EXIT
for ((i=0;i<100;i++)); do
  [[ -S "$run/brumm.sock" ]] && break
  kill -0 "$fake" || exit 1
  sleep .1
done
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null; then
  # exec keeps the launcher's PID, so Hyprland applies the rules to Qt.
  {
    printf '#!/usr/bin/env bash\nprintf "%%s" "$$" > %q\nexec env ' "$run/gui.pid"
    printf '%q ' "XDG_RUNTIME_DIR=$run" "XDG_CONFIG_HOME=$run/config" "XDG_CACHE_HOME=$run/cache" "BRUMM_PROTOTYPE=1" "BRUMM_DESKTOP_RUNTIME=$desktop_runtime" "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" "$(realpath "$build/brumm-gui")"
    printf '\n'
  } > "$run/start-gui"
  XDG_RUNTIME_DIR="$desktop_runtime" hyprctl dispatch "hl.dsp.exec_cmd(\"exec bash $run/start-gui\", { workspace = \"4 silent\", no_initial_focus = true })"
  for ((i=0;i<100;i++)); do
    [[ -s $run/gui.pid ]] && break
    sleep .1
  done
  [[ -s $run/gui.pid ]] || { echo 'Prototype launch failed' >&2; exit 1; }
  wait "$fake"
else
  "$build/brumm-gui"
fi
